NODE_ENV=development
PORT=4000
HOST=0.0.0.0
PUBLIC_SITE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=loopback

# =====================================================================
# XAMPP MySQL Database Configuration (Default XAMPP Settings)
# =====================================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ultradownloader_db

# Storage paths
VAULT_STORAGE_DIR=./storage/vault
TEMP_EPHEMERAL_DIR=./storage/tmp
DOWNLOAD_TICKET_TTL_SECONDS=7200

# =====================================================================
# Security Secrets — MUST BE REPLACED WITH STRONG RANDOM KEYS IN PROD
# =====================================================================
JWT_ADMIN_SECRET=replace_with_64_char_random_admin_jwt_secret_in_production
JWT_USER_SECRET=replace_with_64_char_random_user_jwt_secret_in_production
PADLOCK_TICKET_SECRET=replace_with_64_char_random_padlock_secret_in_production
DOWNLOAD_TICKET_SECRET=replace_with_64_char_random_download_ticket_secret_in_production
AES_256_VAULT_KEY=7f9a8b2c4d6e1f3a5b7c9d0e2f4a6b8c1d3e5f7a9b0c2d4e6f8a0b1c3d5e7f9a

# Super-Admin 2FA Configuration
# - In production (NODE_ENV=production), RFC-6238 TOTP is ALWAYS enforced and dev codes are disabled.
# - In local development, set ADMIN_REQUIRE_TOTP=false to allow password+PIN without 2FA,
#   or set ADMIN_ALLOW_DEV_TOTP_CODE=123456 for automated local testing.
ADMIN_TOTP_SECRET=JBSWY3DPEHPK3PXP
ADMIN_REQUIRE_TOTP=true
ADMIN_ALLOW_DEV_TOTP_CODE=123456
ADMIN_IP_ALLOWLIST=
ADMIN_MAX_FAILED_ATTEMPTS=3
ADMIN_BAN_DURATION_MINUTES=30
