# Dependencies & build output
node_modules/
backend/node_modules/
frontend/node_modules/
frontend/dist/
dist/
build/
coverage/

# Environment files (keep only *.env.example tracked in Git)
.env
.env.*
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
!.env.example
!backend/.env.example
!frontend/.env.example

# Ephemeral runtime media & logs
backend/storage/tmp/*
!backend/storage/tmp/.gitkeep
backend/storage/vault/*
!backend/storage/vault/.gitkeep
*.log
npm-debug.log*

# OS / Editor
.DS_Store
Thumbs.db
.idea/
.vscode/
