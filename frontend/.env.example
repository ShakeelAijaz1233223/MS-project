# UltraDownloader Frontend — Lockstep Integration Contract v10.0
# ---------------------------------------------------------------------------
# PLACEHOLDER VALUES ONLY — copy this file to `.env` and fill in your own.
# Never commit a real `.env`. Never put a real secret in this file.
# ---------------------------------------------------------------------------

# API base path used by the frontend (proxied to the backend in dev).
VITE_API_BASE_URL=/api/v1

# Backend origin used by the Vite dev-server proxy.
VITE_BACKEND_ORIGIN=http://localhost:4000

# Secret admin portal slug — NO leading slash.
# The admin page lives at http://localhost:5173/<your-slug>.
# Pick a long random slug, e.g. `vault-control-<random-letters-and-digits>`,
# and keep it private. This must match the slug you open in the browser;
# the backend does NOT read this value.
VITE_SECRET_ADMIN_SLUG=your-secret-admin-slug-here
